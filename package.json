{
  "name": "filevra-tools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Filevra - free browser-based tools to resize, compress and convert images and PDFs.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run generate:sitemap",
    "build": "vite-react-ssg build",
    "preview": "vite preview --port 4173 --strictPort --host 127.0.0.1",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "playwright test --project=live",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "bootstrap": "^5.3.9",
    "lucide-react": "^1.80.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vite-react-ssg": "^0.9.2",
    "vitest": "^5.1.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
