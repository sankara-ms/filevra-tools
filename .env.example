# Public site URL used for canonical links, sitemap and Open Graph tags.
# Change this only if the production domain changes.
VITE_SITE_URL=https://filevra.app

# Contact address shown on the Contact page. Leave empty to hide the address
# and route visitors to GitHub issues instead.
VITE_CONTACT_EMAIL=

# Google AdSense. Leave empty until an approved publisher account exists.
# Advertising scripts are not loaded while these values are empty.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_CONTENT=
VITE_ADSENSE_SLOT_RESULT=
